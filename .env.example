# Variáveis de Ambiente — Criativo Video Studio
# Copie ou adicione estas chaves no arquivo .env do seu Criativo AI Studio

# Groq Cloud (Gratuito em https://console.groq.com)
# Utilizado para transcrição rápida Whisper Large V3 com marcação de tempo palavra por palavra
GROQ_API_KEY=

# Pexels API (Gratuito em https://www.pexels.com/api/)
# Utilizado para download automático de vídeos de stock verticais (9:16) em alta definição
PEXELS_API_KEY=
